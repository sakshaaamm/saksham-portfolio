# Copy this file to .env.local and fill in the values you need.
# The site runs without any of these — they only enable optional features.

# ── Public site info (safe to expose; shipped to the browser) ──
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000

# ── Supabase: projects, analytics, admin panel (optional) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend: sending contact + newsletter email (optional) ──
RESEND_API_KEY=
RESEND_FROM=Portfolio <onboarding@resend.dev>

# ── Admin panel login (optional) ──
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=you@example.com

# ── Resume button (optional) ──
NEXT_PUBLIC_RESUME_URL=
